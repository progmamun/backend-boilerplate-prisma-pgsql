{
  "name": "backend-starter-pack",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:tsup": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint ./src/**/*",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "push": "prisma db push",
    "pull": "prisma db pull",
    "format": "prettier --write \"src/**/*.ts\"",
    "module:create": "node scripts/create-module.js",
    "module:create:no-route": "node scripts/create-module.js --no-route",
    "prisma:generate": "prisma generate --schema=./prisma/schema",
    "prisma:push": "prisma db push --schema=./prisma/schema",
    "prisma:studio": "prisma studio --schema=./prisma/schema",
    "prisma:seed": "ts-node src/app/db/seed.ts",
    "postinstall": "prisma generate --schema=./prisma/schema"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/qs": "^6.15.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "qs": "^6.15.1",
    "redis": "^5.12.1",
    "response-time": "^2.3.4",
    "sharp": "^0.34.5",
    "streamifier": "^0.1.1",
    "stripe": "^14.25.0",
    "uuid": "^13.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/response-time": "^2.3.9",
    "@types/streamifier": "^0.1.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
